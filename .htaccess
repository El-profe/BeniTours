# trinidad_turismo/.htaccess
# Configuración perimetral de seguridad para Apache en cPanel y entornos locales

# 1. Desactivar listado de directorios y ejecución CGI innecesaria
Options -Indexes -ExecCGI

# 2. Ocultar firma del servidor
ServerSignature Off

# 3. Proteger archivos ocultos y archivos sensibles (.env, .git, .sql, .log, .md, .lock)
<FilesMatch "(^\.|\.env|\.sql|\.log|\.md|\.json|\.lock)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Reglas de reescritura seguras
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear el acceso directo a carpetas sensibles del backend
    RewriteRule ^(app|config|database|storage|docs|bin|routes|tests)(/.*)?$ - [F,L,NC]

    # Redirigir el tráfico hacia public/ si se sube en la raíz del dominio
    RewriteCond %{REQUEST_URI} !^/(.*)/public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>