# public/assets/.htaccess
# Directorio exclusivo de recursos estáticos (CSS, JS, imágenes, fuentes)

Options -Indexes -ExecCGI

# Denegar ejecución de cualquier script ejecutable
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phar|pl|py|cgi|sh|bash)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>